# Dockerfile pour le serveur des assistants avec Gemini CLI
# Compatible avec Render.com et autres plateformes Docker

FROM node:20-slim

# Installer les dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Créer le répertoire de l'application
WORKDIR /app

# Copier les fichiers package
COPY package*.json ./

# Installer les dépendances Node.js
RUN npm ci --only=production

# Installer Gemini CLI globalement
RUN npm install -g @google/gemini-cli

# Copier le code source
COPY scripts/ ./scripts/
COPY assistant/ ./assistant/
COPY .env.example ./.env

# Créer le répertoire pour les credentials OAuth
RUN mkdir -p /root/.gemini

# Variables d'environnement par défaut
ENV NODE_ENV=production
ENV ASSISTANT_PORT=10000
ENV GEMINI_DEFAULT_MODEL=auto
ENV ASSISTANTS_PATH=/app/assistant

# Exposer le port (Render utilise le port 10000 par défaut)
EXPOSE 10000

# Script de démarrage
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "scripts/server-assistants-standalone.js"]
