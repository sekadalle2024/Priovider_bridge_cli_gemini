{
    "version": 2,
    "builds": [
        {
            "src": "src/server.ts",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "src/server.ts"
        },
        {
            "src": "/v1/(.*)",
            "dest": "src/server.ts"
        },
        {
            "src": "/docs",
            "dest": "src/server.ts"
        },
        {
            "src": "/openapi.json",
            "dest": "src/server.ts"
        },
        {
            "src": "/health",
            "dest": "src/server.ts"
        },
        {
            "src": "/(.*)",
            "dest": "public/$1"
        }
    ]
}