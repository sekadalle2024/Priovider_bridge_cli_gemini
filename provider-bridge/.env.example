# ============================================================
# Provider Bridge Endpoint — Configuration
# ============================================================

# Server
PORT=25809
HOST=127.0.0.1
# Set to true for remote access (0.0.0.0)
ALLOW_REMOTE=false

# JWT Secret (change this in production!)
JWT_SECRET=change-me-to-a-secure-random-string

# Admin credentials (first boot only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Google OAuth (for Gemini CLI auth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:25809/api/auth/google/callback

# Gemini API Keys for rotation (add as many as needed)
# GEMINI_API_KEY_1=AIza...
# GEMINI_API_KEY_2=AIza...
# GEMINI_API_KEY_3=AIza...

# Available Gemini models (comma-separated, no spaces)
# Used by both /v1/models and /v1/cli/models endpoints.
# If not set, all default models are listed.
# GEMINI_AVAILABLE_MODELS=gemini-3-flash,gemini-3-pro,gemini-2.5-flash,gemini-2.5-pro,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro,gemini-exp-1206

# Kiro CLI path (auto-detected if in PATH)
# KIRO_CLI_PATH=/usr/local/bin/kiro

# Netlify / Vercel
# NODE_ENV=production
