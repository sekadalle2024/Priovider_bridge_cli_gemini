# =============================================================================
# Configuration Multi-CLI Gemini - Exemple
# =============================================================================
# Copiez ce fichier et ajoutez le contenu à votre .env
# Ou utilisez le script automatique: npm run setup:multi-cli

# -----------------------------------------------------------------------------
# Activer le mode Multi-CLI
# -----------------------------------------------------------------------------
MULTI_CLI_ENABLED=true

# Liste des profils (séparés par des virgules)
MULTI_CLI_PROFILES=profile1,profile2,profile3,profile4

# Stratégie de load balancing
# Options: round-robin, least-loaded, random, weighted
CLI_LOAD_BALANCER_STRATEGY=round-robin

# -----------------------------------------------------------------------------
# Configuration des Profils
# -----------------------------------------------------------------------------

# Profil 1 - Compte principal
CLI_PROFILE1_HOME=~/.gemini-profile1
CLI_PROFILE1_PORT=25811
CLI_PROFILE1_ACCOUNT=votre-email-1@gmail.com
CLI_PROFILE1_ENABLED=true

# Profil 2 - Compte secondaire
CLI_PROFILE2_HOME=~/.gemini-profile2
CLI_PROFILE2_PORT=25812
CLI_PROFILE2_ACCOUNT=votre-email-2@gmail.com
CLI_PROFILE2_ENABLED=true

# Profil 3 - Compte tertiaire
CLI_PROFILE3_HOME=~/.gemini-profile3
CLI_PROFILE3_PORT=25813
CLI_PROFILE3_ACCOUNT=votre-email-3@gmail.com
CLI_PROFILE3_ENABLED=true

# Profil 4 - Compte supplémentaire (optionnel)
CLI_PROFILE4_HOME=~/.gemini-profile4
CLI_PROFILE4_PORT=25814
CLI_PROFILE4_ACCOUNT=votre-email-4@gmail.com
CLI_PROFILE4_ENABLED=true

# -----------------------------------------------------------------------------
# Configuration du Serveur Multi-CLI
# -----------------------------------------------------------------------------

# Port du serveur (défaut: 25810)
PORT=25810

# Timeout pour les requêtes Gemini CLI (en ms)
CLI_REQUEST_TIMEOUT=60000

# Nombre maximum de tentatives en cas d'échec
CLI_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# 1. Créez d'abord les profils avec:
#    $env:GEMINI_CLI_HOME="$HOME\.gemini-profile1"
#    gemini auth login
#
# 2. Répétez pour chaque profil avec un compte Google différent
#
# 3. Compilez le projet:
#    npm run build
#
# 4. Démarrez le serveur:
#    npm run multi-cli
#
# 5. Testez:
#    npm run test:multi-cli
