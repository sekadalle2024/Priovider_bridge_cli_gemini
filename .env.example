# Configuration Gemini CLI API Endpoint
# Copy this file to .env and fill in your values

# ============================================
# ASSISTANTS MICROSERVICES
# ============================================

# Activer le serveur des assistants
ASSISTANTS_ENABLED=true

# Port du serveur des assistants (défaut: 25810, évite conflit avec provider-bridge:25809)
ASSISTANT_PORT=25810

# Démarrage automatique avec l'application Electron
ASSISTANTS_AUTO_START=true

# Chemin vers le dossier des assistants (défaut: ./assistant)
ASSISTANTS_PATH=./assistant

# Chemin vers Gemini CLI (défaut: gemini)
GEMINI_CLI_PATH=gemini

# Modèle Gemini par défaut pour les assistants
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-exp

# ============================================
# Gemini Configuration
# ============================================

# Gemini API Key (optionnel si OAuth Google est configuré)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini Model (défaut: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Google Gemini Base URL (optionnel)
GOOGLE_GEMINI_BASE_URL=

# Google Cloud Project ID (optionnel, pour Vertex AI)
GOOGLE_CLOUD_PROJECT=

# ============================================
# Server Configuration
# ============================================

# Port du serveur WebUI (défaut: 25808)
AIONUI_PORT=25808

# Workspace path (défaut: current directory)
WORKSPACE_PATH=

# Proxy (optionnel)
HTTP_PROXY=
HTTPS_PROXY=

# YOLO Mode - Auto-approve all actions (défaut: false)
GEMINI_YOLO_MODE=false

# ============================================
# Authentication
# ============================================

# CSRF Secret (32 caractères, généré automatiquement si non défini)
CSRF_SECRET=

# JWT Secret (généré automatiquement si non défini)
JWT_SECRET=

# ============================================
# CORS Configuration
# ============================================

# Server Base URL (pour CORS)
SERVER_BASE_URL=

# Additional allowed origins (séparés par des virgules)
AIONUI_ALLOWED_ORIGINS=

# ============================================
# Netlify/Vercel Deployment
# ============================================

# Pour Netlify et Vercel, configurez ces variables dans leur dashboard:
# - GEMINI_API_KEY
# - GEMINI_MODEL
# - GOOGLE_GEMINI_BASE_URL (optionnel)

# ============================================
# Notes
# ============================================

# 1. Authentification Google OAuth:
#    - Lancer "gemini" CLI pour s'authentifier
#    - Les credentials sont sauvegardés dans ~/.gemini/oauth_creds.json
#    - Si OAuth est configuré, GEMINI_API_KEY n'est pas nécessaire

# 2. Pour utiliser avec n8n:
#    - Démarrer le serveur: npm run webui:remote
#    - Obtenir un token JWT depuis l'interface web
#    - Utiliser le token dans le header Authorization

# 3. Pour déployer sur Netlify/Vercel:
#    - Configurer GEMINI_API_KEY dans leur dashboard
#    - OAuth Google n'est pas supporté en serverless
